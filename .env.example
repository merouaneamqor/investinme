# Ethereum network: sepolia (default) or mainnet
ETH_NETWORK=sepolia

# JSON-RPC endpoint. Defaults to a public node for the selected network.
ETH_RPC_URL=

# 32-byte hex seed, or any passphrase hashed to derive deposit addresses.
# Never commit a production seed.
ETH_MASTER_SEED=

# Hot wallet private key used to send USDT withdrawals (hex, optional 0x).
ETH_HOT_WALLET_PRIVATE_KEY=

# Optional cron/API auth for /api/ethereum/sync
# ETH_SYNC_SECRET=

# How many recent blocks to scan for inbound USDT (optional).
# ETH_DEPOSIT_LOOKBACK_BLOCKS=2000

# Local development helpers
# ETH_SIMULATE_TRANSFERS=1
# ETH_CONFIRM_AFTER_BROADCAST=1
# SESSION_SECRET=change-me
# DATABASE_PATH=./data/investinme.sqlite
